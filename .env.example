# Supabase — crie um projeto em https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Project Settings > API > service_role (NUNCA expor no client)
SUPABASE_SERVICE_ROLE_KEY=

# Hotmart — o "Hottok" configurado no cadastro do webhook
# (Hotmart > Ferramentas > Webhook)
HOTMART_WEBHOOK_TOKEN=

# Hotmart — ID do produto (Hotmart > Produtos > [seu produto] > Detalhes).
# Se definido, o webhook ignora eventos de qualquer outro produto da conta —
# importante quando a mesma conta Hotmart vende mais de um produto.
HOTMART_PRODUCT_ID=
